# ===========================================================================
# 光影选片助手 .gitignore —— MVP 仓库规则
# ===========================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
pycache/          # start.bat 里 PYTHONPYCACHEPREFIX 的字节码缓存目录

# ---- 虚拟环境 / 缓存（不落仓库）----
.venv/
.pip_cache/
.hf_cache/
.torch_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 数据（测试图 / 索引库 / 上传目录）----
data/
# 例外：models 目录只提交小权重（LAION 美学头约 3KB），
#       大权重（CLIP / 闭眼 ViT / MediaPipe）首次运行自动下载到 .hf_cache
!models/
models/*
!models/sa_0_4_vit_b_32_linear.pth

# ---- 日志 / 运行期文件 ----
*.log
*.db
*.db-wal
*.db-shm
_srv.log
_srv_err.log

# ---- IDE / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
